[Unit]
Description=Guess Who Game (monolith: FastAPI + SPA + Socket.IO)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/workspace/guess-who-game/backend
ExecStart=/root/workspace/guess-who-game/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8088
Restart=always
RestartSec=5
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
